import std.hashmap.{HashMap, newHashMap}

// Keep every key in one chain even after rehashing.
def collisionHasher(map: HashMap var&, key: u32): usize {
  0
}

def expectedValue(key: u32): u8 var* {
  if key % 2 == 0 { null }
  else { (key + 1) as usize as u8 var* }
}

def checkNullValues(): i32 {
  var map = newHashMap(collisionHasher)
  var i: u32 = 0
  while i < 32 {
    if !map.insert(i, expectedValue(i)) { return 10 }
    i += 1
  }
  let capacity = map.capacity()
  i = 0
  while i < 32 {
    // Reject replacement with either a null or a non-null value, including
    // null-valued keys in the middle and at the end of the collision chain.
    if map.insert(i, 999 as u8 var*) { return 11 }
    if map.insert(i, null) { return 12 }
    if map.get(i) != expectedValue(i) { return 13 }
    i += 1
  }
  if map.size() != 32 || map.capacity() != capacity { return 14 }
  // Force rehashes while preserving null and non-null values in the chain.
  while i < 97 {
    if !map.insert(i, expectedValue(i)) { return 15 }
    i += 1
  }
  if map.capacity() <= capacity { return 16 }
  let grown_capacity = map.capacity()
  i = 0
  while i < 97 {
    if map.get(i) != expectedValue(i) { return 17 }
    if map.insert(i, 999 as u8 var*) { return 18 }
    i += 1
  }
  if map.size() != 97 || map.capacity() != grown_capacity { return 19 }
  var seen = 0
  for pair in map.iter() {
    if pair.key() >= 97 || pair.value() != expectedValue(pair.key()) {
      return 20
    }
    seen += 1
  }
  if seen != 97 { return 21 }
  // Remove null-valued keys at different positions after rehashing.
  let removed = [u32[3]] {96, 48, 0}
  var index = 0
  while index < 3 {
    let key = removed[index]
    if !map.remove(key) || map.remove(key) { return 22 }
    if map.get(key) != null { return 23 }
    index += 1
  }
  if map.size() != 94 { return 24 }
  if !map.insert(0, null) { return 25 }
  if map.insert(0, 999 as u8 var*) { return 26 }
  if !map.remove(0) || !map.insert(0, 999 as u8 var*) {
    return 27
  }
  if map.get(0) != 999 as u8 var* { return 28 }
  map.clear()
  let empty_iter = map.iter()
  if !map.empty() || !empty_iter.last() { return 29 }
  if map.remove(0) { return 30 }
  if !map.insert(0, null) || !map.remove(0) {
    return 31
  }
  if !map.empty() { return 32 }
  map.del()
  0
}

extern def check_hashmap(): i32 {
  let null_result = checkNullValues()
  if null_result != 0 { return null_result }
  var map = newHashMap(), i = 0
  while i < 1000 {
    if !map.insert((i * 32) as u32, (i + 1) as usize as u8 var*) {
      return 1
    }
    i += 1
  }
  if map.capacity() < map.size() { return 2 }
  i = 0
  while i < 1000 {
    if map.get((i * 32) as u32) as usize != (i + 1) as usize { return 3 }
    if map.insert((i * 32) as u32, 1 as u8 var*) { return 4 }
    i += 1
  }
  var seen = 0
  for pair in map.iter() {
    if pair.value() as usize != (pair.key() / 32 + 1) as usize {
      return 5
    }
    seen += 1
  }
  if seen != 1000 { return 6 }
  i = 0
  while i < 1000 {
    if !map.remove((i * 32) as u32) { return 7 }
    i += 1
  }
  if !map.empty() { return 8 }
  map.del()
  0
}
