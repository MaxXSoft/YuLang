import std.sys.stdlib.{free, malloc}
struct QueueElem {
  val: i32,
  prev: QueueElem var*,
  next: QueueElem var*,
}

public struct Queue {
  head: QueueElem var*,
}


// constructor
public def newQueue(): Queue {
  let head = malloc(sizeof QueueElem) as QueueElem var*
  (*head).prev = head
  (*head).next = head
  [] {head}
}

// check if current queue is empty
public def empty(this: Queue&): bool {
  (*this.head).next == this.head
}

// push element to back of queue
public def push(this: Queue var&, val: i32) {
  let elem = malloc(sizeof QueueElem) as QueueElem var*
  (*elem).val = val
  // push into queue
  let prev = (*this.head).prev
  (*prev).next = elem
  (*elem).prev = prev
  (*this.head).prev = elem
  (*elem).next = this.head
}

// pop element from front of queue
public def pop(this: Queue var&): i32 {
  // get result
  let elem = (*this.head).next, val = (*elem).val
  // pop from queue
  let prev = (*elem).prev, next = (*elem).next
  (*next).prev = prev
  (*prev).next = next
  free(elem as u8*)
  val
}

// destructor
public def del(this: Queue var&) {
  while !this.empty() {
    this.pop()
  }
  free(this.head as u8*)
}
