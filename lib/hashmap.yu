import std.sys.stdlib.{free, malloc}
import std.sys.string.memset
// key-value pair
public struct KeyValue {
  key: u32,
  value: u8 var*,
  next: KeyValue var*,
}

// table of pairs
struct KvPairTable {
  table: KeyValue var* var*,
  size: usize,
  // number of non-null elements in table
  occupied: usize,
}

// table iterator
public struct HashMapIter {
  table: KvPairTable*,
  cur_index: usize,
  cur_pair: KeyValue var*,
}

// hash map (dynamic table size)
public struct HashMap {
  table: KvPairTable,
  // size of hash map
  size: usize,
  // hash function
  hash_func: (HashMap var&, u32): usize,
}

// hash function
public type HashFunc = (HashMap var&, u32): usize


/*
 * key-value pair related implementations
 */
public inline def key(this: KeyValue*): u32 {
  (*this).key
}

public inline def value(this: KeyValue*): u8 var* {
  (*this).value
}


/*
 * iterator related implementations
 */
// set 'cur_index' and 'cur_pair' to next avaliable index
// which means 'table[cur_index]' is not null
def findNextIndex(this: HashMapIter var&) {
  while this.cur_index < (*this.table).size {
    if (*this.table).table[this.cur_index] != null {
      this.cur_pair = (*this.table).table[this.cur_index]
      break
    }
    this.cur_index += 1
  }
}

// iterator method 'next'
public def next(this: HashMapIter var&): KeyValue var* {
  let cur = this.cur_pair
  // find next key-value pair
  this.cur_pair = (*this.cur_pair).next
  if this.cur_pair == null {
    this.cur_index += 1
    this.findNextIndex()
  }
  cur
}

// iterator method 'last'
public inline def last(this: HashMapIter&): bool {
  this.cur_index >= (*this.table).size
}


/*
 * table related implementations
 */
// internal constructor
def newTable(size: usize): KvPairTable {
  let mem_size = size * sizeof KeyValue var*
  let table = malloc(mem_size) as KeyValue var* var*
  memset(table as u8 var*, 0, mem_size)
  [] {table, size, 0}
}

// internal destructor
def del(this: KvPairTable var&) {
  var i = 0
  while i as usize < this.size {
    var cur = this.table[i]
    while cur != null {
      let next = (*cur).next
      free(cur as u8*)
      cur = next
    }
    i += 1
  }
  free(this.table as u8*)
}

// insert existing pair to table
def insert(this: KvPairTable var&, index: usize, pair: KeyValue var*) {
  if this.table[index] == null {
    this.occupied += 1
  }
  (*pair).next = this.table[index]
  this.table[index] = pair
}

// insert key-value pair to table
def insert(this: KvPairTable var&, index: usize,
           key: u32, value: u8 var*) {
  // allocate a new key-value pair
  let pair = malloc(sizeof KeyValue) as KeyValue var*
  (*pair).key = key
  (*pair).value = value
  // insert to table
  this.insert(index, pair)
}

// Find the node independently of its value, which may be null.
def find(this: KvPairTable&, index: usize, key: u32): KeyValue* {
  var cur = this.table[index]
  while cur != null {
    if (*cur).key == key {
      return cur
    }
    cur = (*cur).next
  }
  null
}

// remove value by key
def remove(this: KvPairTable var&, index: usize, key: u32): bool {
  var cur = this.table[index], last = this.table + index
  while cur != null {
    if (*cur).key == key {
      (*last) = (*cur).next
      free(cur as u8*)
      if this.table[index] == null {
        this.occupied -= 1
      }
      return true
    }
    last = &((*cur).next)
    cur = (*cur).next
  }
  false
}

// get iterator
def iter(this: KvPairTable&): HashMapIter {
  var iter = [HashMapIter]
             {&this, 0, null}
  iter.findNextIndex()
  iter
}


/*
 * hash map related implementations
 */
// default table size
let TABLE_SIZE: usize = 32

// default hash function
def defaultHasher(this: HashMap var&, key: u32): usize {
  (key as usize) * (0x9e3779b97f4a7c15 as usize)
}

// call hash function and returns table index
def hash(this: HashMap var&, key: u32): usize {
  (this.hash_func)(this, key) % this.table.size
}

// rehash when the number of pairs reaches the bucket count
// returns true if rehash is performed
def rehash(this: HashMap var&): bool {
  if this.size >= this.table.size {
    // allocate new table
    let size = this.table.size * 2
    var table = newTable(size)
    // move key-value pairs to new table
    for kv in this.table.iter() {
      let hash_val = (this.hash_func)(this, kv.key()) % size
      table.insert(hash_val, kv)
    }
    // update table
    // NOTE: do not use 'del' method
    //       because it will release all existing pairs
    free(this.table.table as u8*)
    this.table = table
    true
  }
  else {
    false
  }
}

// constructor (with parameters)
public def newHashMap(hash_func: HashFunc): HashMap {
  [] {newTable(TABLE_SIZE), 0, hash_func}
}

// constructor
public def newHashMap(): HashMap {
  newHashMap(defaultHasher)
}

// destructor
public def del(this: HashMap var&) {
  this.table.del()
}

// Number of entries that fit before the next table growth.
public inline def capacity(this: HashMap&): usize {
  this.table.size
}

public inline def size(this: HashMap&): usize {
  this.size
}

public inline def empty(this: HashMap&): bool {
  this.size == 0
}

// Insert a new key, including null values; never replace an existing key.
public def insert(this: HashMap var&, key: u32, value: u8 var*): bool {
  var hash_val = this.hash(key)
  if this.table.find(hash_val, key) == null {
    if this.rehash() {
      hash_val = this.hash(key)
    }
    this.table.insert(hash_val, key, value)
    this.size += 1
    true
  }
  else {
    false
  }
}

// Return the value, or null if the key is absent or stores a null value.
public def get(this: HashMap var&, key: u32): u8 var* {
  let hash_val = this.hash(key)
  let pair = this.table.find(hash_val, key)
  if pair == null {
    null
  }
  else {
    pair.value()
  }
}

// remove value by key
public def remove(this: HashMap var&, key: u32): bool {
  let hash_val = this.hash(key)
  let ret = this.table.remove(hash_val, key)
  if ret {
    this.size -= 1
  }
  ret
}

// remove all key-value pairs
public def clear(this: HashMap var&) {
  this.table.del()
  this.table = newTable(TABLE_SIZE)
  this.size = 0
}

// get iterator
public def iter(this: HashMap&): HashMapIter {
  this.table.iter()
}
