import std.sys.string.strlen
public struct StrView {
  str: u8*,
  len: usize,
}

// create a new string view by a null terminated string
public inline def newStrView(str: u8*): StrView {
  [] {str, strlen(str)}
}

// create a new string view by a slice of bytes
public inline def newStrView(buf: u8*, len: usize): StrView {
  [] {buf, len}
}

// get string data of string view (not guarantee to be null terminated)
public inline def str(this: StrView&): u8* {
  this.str
}

// get length of string view
public inline def len(this: StrView&): usize {
  this.len
}

// check whether the view is empty
public inline def empty(this: StrView&): bool {
  this.len == 0
}

// get the specified character
public inline def at(this: StrView&, i: i32): u8 {
  this.str[i]
}
public inline def at(this: StrView&, i: usize): u8 {
  this.str[i]
}

// get the first character
public inline def front(this: StrView&): u8 {
  this.str[0]
}

// get the last character
public inline def back(this: StrView&): u8 {
  this.str[this.len - 1]
}

// check if equals to a null terminated string
public def ==(this: StrView&, str: u8*): bool {
  var i = 0
  while i as usize < this.len {
    if this.str[i] != str[i] || str[i] == '\0' {
      return false
    }
    i += 1
  }
  str[i] == '\0'
}
public inline def !=(this: StrView&, str: u8*): bool {
  !(this == str)
}
public inline def ==(str: u8*, this: StrView&): bool {
  this == str
}
public inline def !=(str: u8*, this: StrView&): bool {
  !(this == str)
}

// check if equals to another string view
public def ==(this: StrView&, that: StrView&): bool {
  if this.len == that.len {
    var i = 0
    while i as usize < this.len {
      if this.str[i] != that.str[i] {
        return false
      }
      i += 1
    }
    true
  }
  else {
    false
  }
}
public inline def !=(this: StrView&, that: StrView&): bool {
  !(this == that)
}

// shrinks the view by moving its start forward
public inline def removePrefix(this: StrView var&, n: usize) {
  this.str += n
  this.len -= n
}

// shrinks the view by moving its end backward
public inline def removeSuffix(this: StrView var&, n: usize) {
  this.len -= n
}


public struct StrViewSplitIter {
  cur: u8*,
  len: usize,
  delimiter: u8,
}

// get split iterator
public inline def split(this: StrView&, delimiter: u8): StrViewSplitIter {
  [] {this.str, this.len, delimiter}
}

// iterator method 'next'
public def next(this: StrViewSplitIter var&): StrView {
  // find next position of delimiter
  var len: usize = 0
  while len < this.len {
    if this.cur[len] == this.delimiter {
      break
    }
    len += 1
  }
  // get next string view
  let sv = newStrView(this.cur, len)
  // update current iterator
  if len < this.len {
    len += 1
  }
  this.cur += len
  this.len -= len
  sv
}

// iterator method 'last'
public inline def last(this: StrViewSplitIter&): bool {
  this.len == 0
}
