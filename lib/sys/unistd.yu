// standard file descriptors
public inline let FD_STDIN   = 0
public inline let FD_STDOUT  = 1
public inline let FD_STDERR  = 2

// UNIX standard operations
public extern declare read:  (i32, u8 var*, usize): isize
public extern declare write: (i32, u8*, usize): isize
public extern declare close: (i32): i32
