// basic operations
public extern declare fabsf: (f32): f32
public extern declare fabs: (f64): f64
public extern declare fmaxf: (f32, f32): f32
public extern declare fmax: (f64, f64): f64
public extern declare fminf: (f32, f32): f32
public extern declare fmin: (f64, f64): f64

// exponential functions
public extern declare expf: (f32): f32
public extern declare exp: (f64): f64
public extern declare exp2f: (f32): f32
public extern declare exp2: (f64): f64
public extern declare logf: (f32): f32
public extern declare log: (f64): f64
public extern declare log10f: (f32): f32
public extern declare log10: (f64): f64
public extern declare log2f: (f32): f32
public extern declare log2: (f64): f64

// power functions
public extern declare powf: (f32, f32): f32
public extern declare pow: (f64, f64): f64
public extern declare sqrtf: (f32): f32
public extern declare sqrt: (f64): f64

// trigonometric functions
public extern declare sinf: (f32): f32
public extern declare sin: (f64): f64
public extern declare cosf: (f32): f32
public extern declare cos: (f64): f64
public extern declare tanf: (f32): f32
public extern declare tan: (f64): f64
public extern declare asinf: (f32): f32
public extern declare asin: (f64): f64
public extern declare acosf: (f32): f32
public extern declare acos: (f64): f64
public extern declare atanf: (f32): f32
public extern declare atan: (f64): f64

// hyperbolic functions
public extern declare sinhf: (f32): f32
public extern declare sinh: (f64): f64
public extern declare coshf: (f32): f32
public extern declare cosh: (f64): f64
public extern declare tanhf: (f32): f32
public extern declare tanh: (f64): f64
public extern declare asinhf: (f32): f32
public extern declare asinh: (f64): f64
public extern declare acoshf: (f32): f32
public extern declare acosh: (f64): f64
public extern declare atanhf: (f32): f32
public extern declare atanh: (f64): f64

// nearest integer floating-point operations
public extern declare ceilf: (f32): f32
public extern declare ceil: (f64): f64
public extern declare floorf: (f32): f32
public extern declare floor: (f64): f64
public extern declare truncf: (f32): f32
public extern declare trunc: (f64): f64
public extern declare roundf: (f32): f32
public extern declare round: (f64): f64
// C long follows the pointer-sized Unix ABI used by these bindings.
public extern declare lroundf: (f32): isize
public extern declare lround: (f64): isize
public extern declare llroundf: (f32): i64
public extern declare llround: (f64): i64
