// dynamic memory management
public extern declare malloc: (usize): u8 var*
public extern declare calloc: (usize, usize): u8 var*
public extern declare realloc: (u8*, usize): u8 var*
public extern declare free: (u8*)

// program support utilities
public extern declare abort: ()
public extern declare exit: (i32)
public extern declare atexit: (()): i32

// pseudo-random number generation
public extern declare rand: (): i32
public extern declare srand: (u32)
// Unix ABI: time_t and long have pointer width; see README for target limits.
public extern declare time: (isize var*): isize
public inline def seed(): u32 {
  let s = time(null) as u32
  srand(s)
  s
}

// numeric string conversion
public extern declare strtol: (u8*, u8* var*, i32): isize
public extern declare strtoll: (u8*, u8* var*, i32): i64
public extern declare strtoul: (u8*, u8* var*, i32): usize
public extern declare strtoull: (u8*, u8* var*, i32): u64
public extern declare strtof: (u8*, u8* var*): f32
public extern declare strtod: (u8*, u8* var*): f64
